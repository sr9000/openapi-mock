# Скопируйте в .env и при необходимости переопределите значения для локального запуска.

# --- Application configuration (read by the server) ---
HOST=0.0.0.0
PORT=8080
METRICS_PORT=9100
MGMT_PORT=9000

# HTTP Options
HTTP_LOGGING=false

# Logging / tracing defaults for the observability stack
LOG_FORMAT=json
LOG_OUTPUT=file
TRACE_ENABLED=true
TRACE_SAMPLING_RATIO=1.0

# --- Docker Compose host-port mapping (observability stack) ---
# HTTP_PORT maps the host port for the mock in docker-compose.observability.yaml.
# Keep it in sync with PORT above.
HTTP_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
